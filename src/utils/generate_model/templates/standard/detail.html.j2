{% extends "core/base.html" %}

{% block title %}{{ label }} - Detalhe{% endblock %}

{% block content %}
{% set item = {{ class_name_lower }} %}
<div class="pagetitle">
  <h1>{{ label }}</h1>
  <nav>
    <ol class="breadcrumb">
      <li class="breadcrumb-item"><a href="{{ url_for('web.dashboard') }}">Home</a></li>
      <li class="breadcrumb-item"><a href="{{ url_for(plural ~ '.list') }}">{{ label }}s</a></li>
      <li class="breadcrumb-item active">Detalhe #{{ item.id }}</li>
    </ol>
  </nav>
</div>

<section class="section">
  <div class="row">
    <div class="col-lg-12">
      <div class="card">
        <div class="card-body">
          <h5 class="card-title">Informações</h5>
          <table class="table table-bordered">
            {{ fields_rows }}
          </table>

          <div class="mt-4">
            <div class="btn-group">
              <a href="{{ url_for(plural ~ '.list') }}" class="btn btn-secondary">Voltar</a>

              {% set item_status = item.status.value if item.status is not string else item.status %}

              {% if item_status == 'active' %}
                <button type="button" class="btn btn-primary" id="btnEdit{{ class_name }}" data-id="{{ item.id }}">Editar</button>
                <form method="post" action="{{ url_for(plural ~ '.trash', **{class_name_lower ~ '_id': item.id}) }}" class="d-inline" onsubmit="return confirm('Mover para lixeira?')">
                  <button type="submit" class="btn btn-outline-danger">Mover para lixeira</button>
                </form>
              {% elif item_status == 'draft' %}
                <button type="button" class="btn btn-primary" id="btnEdit{{ class_name }}" data-id="{{ item.id }}">Continuar edição</button>
                <form method="post" action="{{ url_for(plural ~ '.discard_draft', **{class_name_lower ~ '_id': item.id}) }}" class="d-inline" onsubmit="return confirm('Descartar rascunho?')">
                  <button type="submit" class="btn btn-danger">Descartar</button>
                </form>
              {% elif item_status == 'trash' %}
                <form method="post" action="{{ url_for(plural ~ '.restore', **{class_name_lower ~ '_id': item.id}) }}" class="d-inline">
                  <button type="submit" class="btn btn-success">Restaurar</button>
                </form>
                {% if current_user.is_admin %}
                <form method="post" action="{{ url_for(plural ~ '.delete_permanent', **{class_name_lower ~ '_id': item.id}) }}" class="d-inline" onsubmit="return confirm('Excluir permanentemente?')">
                  <button type="submit" class="btn btn-danger">Excluir permanentemente</button>
                </form>
                {% endif %}
              {% endif %}
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

{% include output_subdir ~ '/' ~ plural ~ '/_modals/' ~ class_name_lower ~ '_form_modal.html' %}
{% endblock %}

{% block extra_js %}
<script>
  (function() {
    const modalEl = document.getElementById('{{ class_name_lower }}Modal');
    if (!modalEl) return;
    const modal   = new bootstrap.Modal(modalEl);
    const editBtn = document.getElementById('btnEdit{{ class_name }}');
    if (!editBtn) return;

    editBtn.addEventListener('click', () => {
      modalEl.addEventListener('shown.bs.modal', function onShown() {
        modalEl.removeEventListener('shown.bs.modal', onShown);
        window['load{{ class_name }}Data']?.(editBtn.dataset.id);
      }, { once: true });
      modal.show();
    });
  })();
</script>
{% endblock %}
