from __future__ import annotations

from datetime import datetime, timezone
from enum import Enum as PyEnum

from sqlalchemy import DateTime, Enum, Integer, String, Text, Boolean, Float, ForeignKey, Index
from sqlalchemy.orm import Mapped, mapped_column, relationship

from db.database import db
from annotations import (
    label, plural, listview, Column, Filter, form, Group,
    required, max_length, display_field, choices,
)


class {{ class_name }}Status(str, PyEnum):
    """Status do ciclo de vida do registro (soft-delete padrão do projeto)."""
    DRAFT  = "draft"
    ACTIVE = "active"
    TRASH  = "trash"


{% if annotations.label %}
@label("{{ annotations.label }}")
{% endif %}
{% if annotations.plural %}
@plural("{{ annotations.plural }}")
{% endif %}
{% if annotations.listview %}
@listview(
    columns=[
        Column("id", label="ID", width="60px", sortable=True),
        {% for col in annotations.listview.columns %}
        Column("{{ col.name }}", label="{{ col.label }}"{% if col.width %}, width="{{ col.width }}"{% endif %}, sortable={{ "True" if col.sortable else "False" }}, align="{{ col.align|default('start') }}"),
        {% endfor %}
        Column("status", label="Status", width="100px", align="center"),
    ],
    default_sort="{{ annotations.listview.default_sort|default('id') }}",
    filters=[
        {% for f in annotations.listview.filters %}
        Filter("{{ f.name }}", type="{{ f.type|default('text') }}"{% if f.placeholder %}, placeholder="{{ f.placeholder }}"{% endif %}),
        {% endfor %}
    ]
)
{% endif %}
{% if annotations.form %}
@form(
    fields={{ (annotations.form.fields or field_names) | tojson }},
    groups=[
        {% for g in annotations.form.groups %}
        Group("{{ g.name }}", "{{ g.label }}", {{ g.fields | tojson }}, collapsible={{ "True" if g.collapsible else "False" }}),
        {% endfor %}
    ]
)
{% endif %}
{% if annotations.display_field %}
@display_field("{{ annotations.display_field }}")
{% endif %}
{% for req in annotations.required %}
@required("{{ req.field }}", "{{ req.message|default('Este campo é obrigatório') }}")
{% endfor %}
{% for ml in annotations.max_length %}
@max_length("{{ ml.field }}", {{ ml.max }})
{% endfor %}
{% for ch in annotations.choices %}
@choices("{{ ch.field }}", label="{{ ch.label|default(ch.field) }}")
{% endfor %}
class {{ class_name }}(db.Model):
    __tablename__ = "{{ table_name }}"

    id: Mapped[int] = mapped_column(Integer, primary_key=True)

    {% for field in fields %}
    {% if field.is_fk %}
    {{ field.name }}: Mapped[int{% if field.nullable %} | None{% endif %}] = mapped_column(ForeignKey("{{ field.fk_table }}.id"){% if not field.nullable %}, nullable=False{% else %}, nullable=True{% endif %})
    {% else %}
    {{ field.name }}: Mapped[{{ field.py_type }}{% if field.nullable %} | None{% endif %}] = mapped_column({{ field.type_mapped }}{% if field.nullable %}, nullable=True{% else %}, nullable=False{% endif %}{% if field.default is not none %}, default={{ field.default_repr }}{% endif %}{% if field.unique %}, unique=True{% endif %})
    {% endif %}
    {% endfor %}

    status: Mapped[str] = mapped_column(
        Enum({{ class_name }}Status), default={{ class_name }}Status.DRAFT, nullable=False, index=True
    )
    created_at: Mapped[datetime] = mapped_column(
        DateTime(timezone=True), default=lambda: datetime.now(timezone.utc), nullable=False
    )
    updated_at: Mapped[datetime] = mapped_column(
        DateTime(timezone=True), default=lambda: datetime.now(timezone.utc),
        onupdate=lambda: datetime.now(timezone.utc), nullable=False
    )
    trashed_at: Mapped[datetime | None] = mapped_column(DateTime(timezone=True), nullable=True)

    {% for field in fields %}
    {% if field.is_fk %}
    {{ field.fk_relation_name }}: Mapped["{{ field.fk_class }}"] = relationship()
    {% endif %}
    {% endfor %}

    __table_args__ = (Index("ix_{{ table_name }}_status", "status"),)

    # ── Ciclo de vida (soft-delete padrão) ─────────────────────────────────────

    def publish(self) -> None:
        self.status = {{ class_name }}Status.ACTIVE
        self.updated_at = datetime.now(timezone.utc)

    def send_to_trash(self) -> None:
        self.status = {{ class_name }}Status.TRASH
        self.trashed_at = datetime.now(timezone.utc)
        self.updated_at = datetime.now(timezone.utc)

    def restore(self) -> None:
        self.status = {{ class_name }}Status.ACTIVE
        self.trashed_at = None
        self.updated_at = datetime.now(timezone.utc)

    @property
    def is_draft(self) -> bool:
        return self.status == {{ class_name }}Status.DRAFT

    @property
    def is_active(self) -> bool:
        return self.status == {{ class_name }}Status.ACTIVE

    @property
    def is_trashed(self) -> bool:
        return self.status == {{ class_name }}Status.TRASH

    {% for field in fields %}
    {% if field.is_fk and field.display_field %}
    @property
    def {{ field.fk_relation_name }}_name(self) -> str:
        """Nome plano do relacionamento — usado pela SmartList (evita objeto ORM na célula)."""
        return self.{{ field.fk_relation_name }}.{{ field.display_field }} if self.{{ field.fk_relation_name }} else "—"
    {% endif %}
    {% endfor %}

    def to_dict(self) -> dict:
        return {
            "id": self.id,
            {% for field in fields %}
            "{{ field.name }}": self.{{ field.name }},
            {% if field.is_fk and field.display_field %}
            "{{ field.name }}_name": self.{{ field.fk_relation_name }}.{{ field.display_field }} if self.{{ field.fk_relation_name }} else "",
            {% endif %}
            {% endfor %}
            "status": self.status.value if hasattr(self.status, "value") else self.status,
            "created_at": self.created_at.isoformat() if self.created_at else None,
            "updated_at": self.updated_at.isoformat() if self.updated_at else None,
            "trashed_at": self.trashed_at.isoformat() if self.trashed_at else None,
        }

    def __repr__(self) -> str:
        return f"<{{ class_name }} id={self.id}>"
